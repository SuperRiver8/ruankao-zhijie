{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["templateVersion", "namespace", "entries"],
  "additionalProperties": false,
  "properties": {
    "templateVersion": {
      "const": "1.0"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,80}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["kind", "externalId", "payload"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "QUESTION"
          },
          "externalId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,100}$"
          },
          "payload": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "KNOWLEDGE"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/KNOWLEDGE"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "SYLLABUS"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/SYLLABUS"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "MAPPING"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/MAPPING"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "QUESTION"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/QUESTION"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "MATERIAL"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/MATERIAL"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "PAPER"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/PAPER"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "KNOWLEDGE": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string"
        },
        "knowledgeCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attachmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "attachmentPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "certificateCode": {
          "type": "string",
          "minLength": 1
        },
        "syllabusCode": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SYLLABUS": {
      "allOf": [
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string"
            },
            "knowledgeCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attachmentIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "attachmentPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "certificateCode": {
              "type": "string",
              "minLength": 1
            },
            "syllabusCode": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "chapter": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": ["version", "subjects"],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "subjects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["code", "name", "chapters"],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "chapters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["code", "name"],
                      "properties": {
                        "code": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "MAPPING": {
      "allOf": [
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string"
            },
            "knowledgeCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attachmentIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "attachmentPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "certificateCode": {
              "type": "string",
              "minLength": 1
            },
            "syllabusCode": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "chapter": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": ["syllabusCode", "subject", "chapter", "knowledgeCodes"],
          "properties": {
            "knowledgeCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "QUESTION": {
      "allOf": [
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string"
            },
            "knowledgeCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attachmentIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "attachmentPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "certificateCode": {
              "type": "string",
              "minLength": 1
            },
            "syllabusCode": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "chapter": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": ["type", "stem", "difficulty"],
          "properties": {
            "type": {
              "enum": ["SINGLE", "MULTIPLE", "BOOLEAN", "FILL", "SHORT", "CASE", "ESSAY"]
            },
            "stem": {
              "type": "string",
              "minLength": 1
            },
            "difficulty": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "answer": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["id", "text"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/QUESTION"
              }
            },
            "rubric": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1
                },
                {
                  "type": "object",
                  "minProperties": 1
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": ["SINGLE", "MULTIPLE"]
                  }
                }
              },
              "then": {
                "required": ["answer", "options"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": ["BOOLEAN", "FILL"]
                  }
                }
              },
              "then": {
                "required": ["answer"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": ["SHORT", "ESSAY"]
                  }
                }
              },
              "then": {
                "required": ["rubric"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "CASE"
                  }
                }
              },
              "then": {
                "required": ["children"]
              }
            }
          ]
        }
      ]
    },
    "MATERIAL": {
      "allOf": [
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string"
            },
            "knowledgeCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attachmentIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "attachmentPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "certificateCode": {
              "type": "string",
              "minLength": 1
            },
            "syllabusCode": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "chapter": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "anyOf": [
            {
              "required": ["body"],
              "properties": {
                "body": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": ["attachmentIds"],
              "properties": {
                "attachmentIds": {
                  "minItems": 1
                }
              }
            },
            {
              "required": ["attachmentPaths"],
              "properties": {
                "attachmentPaths": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      ]
    },
    "PAPER": {
      "allOf": [
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "body": {
              "type": "string"
            },
            "knowledgeCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "attachmentIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "attachmentPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "certificateCode": {
              "type": "string",
              "minLength": 1
            },
            "syllabusCode": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "type": "string",
              "minLength": 1
            },
            "chapter": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": ["durationMinutes"],
          "properties": {
            "durationMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "points": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "questionIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "oneOf": [
            {
              "required": ["count"],
              "not": {
                "required": ["questionIds"]
              }
            },
            {
              "required": ["questionIds"],
              "not": {
                "required": ["count"]
              }
            }
          ]
        }
      ]
    }
  }
}
