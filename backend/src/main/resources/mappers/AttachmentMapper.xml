<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zhijie.dao.AttachmentMapper">
<resultMap id="AttachmentEntityMap" type="cn.zhijie.pojo.entity.AttachmentEntity">
<result column="id" property="id" />
<result column="owner_id" property="ownerId" /><result
      column="admin_owner_id"
      property="adminOwnerId"
    />
<result column="original_name" property="originalName" />
<result column="storage_key" property="storageKey" />
<result column="media_type" property="mediaType" />
<result column="size" property="size" />
<result column="checksum" property="checksum" />
<result column="access_level" property="accessLevel" />
<result column="created_at" property="createdAt" />
</resultMap>
  <insert id="insertAttachment">
    INSERT INTO
    attachment(id,owner_id,admin_owner_id,original_name,storage_key,media_type,size,checksum,access_level) VALUES(#{id},#{ownerId},#{adminOwnerId},#{name},#{key},#{type},#{size},#{checksum},#{access})
  </insert>
  <select
    id="attachment"
    resultMap="AttachmentEntityMap"
  >SELECT id,owner_id,admin_owner_id,original_name,storage_key,media_type,size,checksum,access_level,created_at FROM attachment WHERE id=#{id}</select>
  <select id="contentAttachment" resultMap="AttachmentEntityMap">
    SELECT id,owner_id,admin_owner_id,original_name,storage_key,media_type,size,checksum,access_level,created_at FROM attachment WHERE admin_owner_id=#{ownerId} AND checksum=#{checksum} AND
    access_level='CONTENT' ORDER BY created_at LIMIT 1
  </select>
  <select id="attachmentPublished" resultType="boolean">
    SELECT EXISTS(SELECT 1 FROM content_version WHERE status='PUBLISHED' AND
    payload->'attachmentIds' @&gt; jsonb_build_array(CAST(#{id} AS text)))
  </select>
</mapper>
