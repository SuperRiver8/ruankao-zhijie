<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zhijie.dao.UserMapper">
  <update id="updateAccount">
    UPDATE app_user SET username=#{username},password_hash=#{password},permission_version=permission_version+1 WHERE id=#{id}
  </update>
<resultMap id="UserEntityMap" type="cn.zhijie.pojo.entity.UserEntity">
<result column="id" property="id" />
<result column="username" property="username" />
<result column="password_hash" property="passwordHash" />
<result column="role" property="role" />
<result column="enabled" property="enabled" />
<result column="permission_version" property="permissionVersion" />
<result column="identity_verified" property="identityVerified" />
<result column="identity_name_encrypted" property="identityNameEncrypted" />
<result column="identity_evidence" property="identityEvidence" />
<result column="member_level" property="memberLevel" />
<result column="created_at" property="createdAt" />
</resultMap>
  <select id="userByName" resultMap="UserEntityMap">
    SELECT id,username,password_hash,role,enabled,permission_version,identity_verified,identity_name_encrypted,identity_evidence,member_level,created_at FROM app_user WHERE username=#{username}
  </select>
  <select
    id="user"
    resultMap="UserEntityMap"
  >SELECT id,username,password_hash,role,enabled,permission_version,identity_verified,identity_name_encrypted,identity_evidence,member_level,created_at FROM app_user WHERE id=#{id}</select>
  <select
    id="lockUser"
    resultMap="UserEntityMap"
  >SELECT id,username,password_hash,role,enabled,permission_version,identity_verified,identity_name_encrypted,identity_evidence,member_level,created_at FROM app_user WHERE id=#{id} FOR UPDATE</select>
  <insert id="insertUser">
    INSERT INTO app_user(id,username,password_hash) VALUES(#{id},#{username},#{password})
  </insert>
  <select id="users" resultMap="UserEntityMap">
    SELECT id,username,role,enabled,identity_verified,member_level FROM app_user ORDER BY created_at
    DESC
  </select>
  <update id="updateUser">
    UPDATE app_user SET role=#{role},enabled=#{enabled},permission_version=permission_version+1
    WHERE id=#{id}
  </update>
  <update id="verifyIdentity">
    UPDATE app_user SET
    identity_verified=true,identity_name_encrypted=#{name},identity_evidence=#{evidence} WHERE
    id=#{id}
  </update>
<select
    id="usersPage"
    resultMap="UserEntityMap"
  >SELECT id,username,role,enabled,identity_verified,member_level FROM app_user
ORDER BY <choose><when test="query.sort == 'id'">id</when><otherwise
      >created_at</otherwise></choose> <choose><when
        test="query.direction == 'asc'"
      >ASC</when><otherwise
      >DESC</otherwise></choose>, id ASC LIMIT #{query.size} OFFSET #{query.offset}</select>
<select
    id="usersCount"
    resultType="long"
  >SELECT count(*) FROM (SELECT id,username,role,enabled,identity_verified,member_level FROM app_user) page_count</select>
</mapper>
