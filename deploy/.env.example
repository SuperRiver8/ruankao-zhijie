# 服务器公网 IP，不包含协议或端口。
SERVER_HOST=127.0.0.1
CUSTOMER_PORT=5173
ADMIN_PORT=5174
# 后台导入任务默认开启，接口文档默认关闭。
JOBS_ENABLED=true
API_DOCS_ENABLED=false
# 滑块拼图：两端登录按最近 120 秒内失败 2 次触发，注册每次验证。
CAPTCHA_WINDOW_SECONDS=120
CAPTCHA_FAILURE_THRESHOLD=2
CAPTCHA_TTL_SECONDS=120
CAPTCHA_TOLERANCE=5
CAPTCHA_ISSUE_LIMIT=30
CAPTCHA_ISSUE_WINDOW_SECONDS=60
# 单层 Nginx 使用独立网络及固定地址；如与已有网络冲突，必须同时修改两项。
AUTH_PROXY_SUBNET=172.30.240.0/24
AUTH_PROXY_IP=172.30.240.10
# 分别生成不同的随机密码。
DATABASE_PASSWORD=
REDIS_PASSWORD=
# 至少 32 字节的随机密钥。
JWT_SECRET=
# Base64 编码的 32 字节密钥，有数据后必须保留原值。
ENCRYPTION_KEY=
