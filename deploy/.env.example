# 数据库名为 ruankao_zhijie，默认连接用户为 zhijie。
# 本地开发可按需覆盖 DATABASE_URL；Compose 使用容器网络内的连接地址。
# DATABASE_URL=jdbc:postgresql://localhost:5432/ruankao_zhijie
# 本地调试默认 auto：不设置 REDIS_HOST 时使用内存，重启后重新登录。
# SESSION_STORE=auto
# 开发环境默认关闭后台导入任务，需要批量导入时启用。
# JOBS_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# Compose 固定使用 prod + redis，不受上述本地设置影响。
DATABASE_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
# 生成方式见 README；必须为 Base64 编码的 32 字节密钥。
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
